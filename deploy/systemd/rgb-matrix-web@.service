[Unit]
Description=RGB Matrix web control service for %i
Documentation=file:/home/%i/rgb_Matrix/docs_agents/web-service-operations.md
After=network.target rgb-matrix-network@%i.service
Wants=network.target rgb-matrix-network@%i.service
ConditionPathExists=/home/%i/rgb_Matrix/matrix_controller/web_service.py

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/%i/rgb_Matrix

# Keep mutable FFT state outside the checkout. systemd creates this directory with
# ownership matching User=/Group= before ExecStart runs.
StateDirectory=rgb-matrix-controller
StateDirectoryMode=0750
Environment=PYTHONUNBUFFERED=1
Environment=RGBMATRIX_STATE_DIR=/var/lib/rgb-matrix-controller

# The service itself remains unprivileged. Configured sudo applies only the fixed,
# allowlisted visualization argv and requires passwordless non-interactive sudo.
# Interpreter, privilege mode, boot visualization, and matrix/visualization defaults
# live in the versioned controller config rather than being duplicated in this unit.
ExecStart=/usr/bin/python3 -m matrix_controller.web_service \
    --config /home/%i/rgb_Matrix/config/matrix-controller.json \
    --host 0.0.0.0 \
    --port 8080 \
    --token-file /home/%i/.config/rgb-matrix-controller/api-token \
    --network-socket /run/rgb-matrix-network/control.sock

Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
UMask=0077
PrivateTmp=true

[Install]
WantedBy=multi-user.target
